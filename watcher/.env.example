# ── Farmboss Bills watcher configuration ──
# Copy this file to ".env" and fill in your values. ".env" is gitignored and
# never leaves your machine.

# Your Bills login — the same email + password you use at bills.html.
BILLS_EMAIL=you@example.com
BILLS_PASSWORD=your-password-here

# Folder to watch. Defaults to ~/Desktop/Paperwork if left blank.
# "~" is expanded to your home folder.
WATCH_DIR=~/Desktop/Paperwork

# Optional overrides. Leave blank to use the Anthropic key/model/proxy you
# already saved in the Bills app (Settings tab).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_PROXY_URL=
