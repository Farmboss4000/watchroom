<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd template for auto-starting the Bills watcher at login on macOS.

  Before using: replace the two /ABSOLUTE/PATH/TO/... paths and the node
  path, then follow the "Auto-start on login" steps in README.md.

  Find your node path with:   which node
    Apple Silicon (Homebrew):  /opt/homebrew/bin/node
    Intel (Homebrew):          /usr/local/bin/node
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.farmboss.bills-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/ABSOLUTE/PATH/TO/watchroom/watcher/watch-paperwork.mjs</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ABSOLUTE/PATH/TO/watchroom/watcher</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/ABSOLUTE/PATH/TO/watchroom/watcher/watcher.log</string>
    <key>StandardErrorPath</key>
    <string>/ABSOLUTE/PATH/TO/watchroom/watcher/watcher.err.log</string>
</dict>
</plist>
