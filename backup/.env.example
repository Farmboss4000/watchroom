# ── Farmboss backup configuration ──
# Copy to ".env" and fill in — or copy the watcher's .env, the same
# BILLS_EMAIL / BILLS_PASSWORD work here.

BILLS_EMAIL=you@example.com
BILLS_PASSWORD=your-password-here

# Where backups are stored. Defaults to ~/FarmbossBackups if blank.
BACKUP_DIR=~/FarmbossBackups
